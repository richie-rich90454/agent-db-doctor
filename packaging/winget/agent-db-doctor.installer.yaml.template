# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.9.0.schema.json
# The installer manifest, filled from this template by
# packaging/generate-winget-manifests.ps1; the hash and the URL only exist once
# the release does, which is why this ships as a template. See packaging/README.md.
#
# The release is a zip whose single top level folder is named for the platform,
# so the relative paths include that folder as well as the executable.
PackageIdentifier: richie-rich90454.agent-db-doctor
PackageVersion: {{VERSION}}
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
- RelativeFilePath: agent-db-doctor-{{VERSION}}-windows-x86_64\agent-db-doctor.exe
  PortableCommandAlias: agent-db-doctor
- RelativeFilePath: agent-db-doctor-{{VERSION}}-windows-x86_64\agent-db-doctor-gui.exe
  PortableCommandAlias: agent-db-doctor-gui
InstallModes:
- silent
- silentWithProgress
- interactive
# An upgrade is the same install over the top of the previous one; without this
# a zip package is treated as uninstall-then-install, which loses the history
# `winget upgrade` needs to keep working.
UpgradeBehavior: install
Installers:
- Architecture: x64
  InstallerUrl: {{URL}}
  InstallerSha256: {{SHA256}}
  # The executables load things from their own folder: the window needs SDL3.dll,
  # and both read the artwork beside them. Without this flag winget extracts only
  # the files named above and leaves the rest of the archive behind, so the
  # installed commands would fail to start. With it the whole archive is extracted
  # and the paths above stay relative to the archive root.
  ArchiveBinariesDependOnPath: true
ManifestType: installer
ManifestVersion: 1.9.0
